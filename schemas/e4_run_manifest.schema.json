{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vanthinh26102005/nckh-ise-blockchain/schemas/e4_run_manifest.schema.json",
  "title": "E4 run manifest / metadata",
  "description": "Committed metadata describing an E4 sweep execution. One manifest per phase run. Points at (but does not embed) the non-committed raw JSONL.",
  "type": "object",
  "required": [
    "experiment",
    "phase",
    "created_at",
    "executor",
    "grid",
    "epochs_target",
    "lambda_events_per_min",
    "seeds_per_cell",
    "cells_total",
    "runs_total",
    "raw_path",
    "topology",
    "software"
  ],
  "additionalProperties": true,
  "properties": {
    "experiment": { "const": "E4", "description": "Experiment tag." },
    "phase": { "enum": ["screening", "confirmation"], "description": "Sweep phase." },
    "created_at": { "type": "string", "description": "ISO-8601 timestamp of run start (passed in; not generated in-script)." },
    "command": { "type": "string", "description": "Exact command used to produce the run." },
    "executor": { "enum": ["mock", "real-e3"], "description": "mock = harness self-test only; real-e3 = official evidence path." },

    "grid": {
      "type": "object",
      "required": ["np", "shipment", "epoch_s"],
      "additionalProperties": false,
      "properties": {
        "np": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "shipment": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "epoch_s": { "type": "array", "items": { "type": "integer" }, "minItems": 1 }
      }
    },
    "epochs_target": { "type": "integer", "const": 4 },
    "lambda_events_per_min": { "type": "number", "description": "Per-producer Poisson rate; expected 3.84." },
    "seeds_per_cell": { "type": "integer", "minimum": 1, "description": "1 for screening, 10 for confirmation." },
    "cells_total": { "type": "integer", "minimum": 1 },
    "runs_total": { "type": "integer", "minimum": 1, "description": "cells_total * seeds_per_cell." },
    "wall_time_s": { "type": ["number", "null"], "description": "Per-run wall-time budget; runs exceeding it are marked saturated." },

    "raw_path": { "type": "string", "description": "Path to the (uncommitted) raw JSONL of cell records." },
    "plan_path": { "type": ["string", "null"], "description": "Path to the committed sweep plan CSV used." },

    "split_host": { "type": "boolean", "description": "Whether GPU proving was on a separate host from Fabric/Anvil." },
    "split_host_rtt_ms": { "type": ["number", "null"] },

    "topology": {
      "type": "object",
      "description": "Fabric + L1 + prover topology used for the run / preflight.",
      "required": ["fabric_orgs", "fabric_peers_per_org", "raft_orderers", "l1", "prover"],
      "additionalProperties": true,
      "properties": {
        "fabric_orgs": { "type": "integer" },
        "fabric_peers_per_org": { "type": "integer" },
        "raft_orderers": { "type": "integer" },
        "gateway": { "type": ["string", "null"] },
        "l1": { "type": "string", "description": "e.g. anvil" },
        "prover": { "type": "string", "description": "e.g. cpu, gpu-a100, gpu-dgx" }
      }
    },

    "preflight_ab": {
      "type": ["object", "null"],
      "description": "CPU vs GPU A/B preflight results (leaf 8/64 event, aggregate 2 lot).",
      "additionalProperties": true,
      "properties": {
        "leaf8_cpu_ms": { "type": ["number", "null"] },
        "leaf8_gpu_ms": { "type": ["number", "null"] },
        "leaf64_cpu_ms": { "type": ["number", "null"] },
        "leaf64_gpu_ms": { "type": ["number", "null"] },
        "aggregate2_cpu_ms": { "type": ["number", "null"] },
        "aggregate2_gpu_ms": { "type": ["number", "null"] }
      }
    },

    "e3_gate_passed": { "type": "boolean", "description": "Whether the E3 aggregate proof gate (Fabric->leaf->SP1 aggregate->Anvil receipt) had passed at run time." },
    "e3_manifest_ref": { "type": ["string", "null"], "description": "Reference to the E3 aggregate manifest / public-values / ABI (handoff)." },

    "software": {
      "type": "object",
      "description": "Version pins for reproducibility.",
      "additionalProperties": true,
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "sp1_version": { "type": ["string", "null"] },
        "fabric_version": { "type": ["string", "null"] },
        "anvil_version": { "type": ["string", "null"] }
      }
    }
  }
}
